	</string>
	<string id="ui_mcm_mag_check_hud_low_ammo_color_desc">
		<text>Turn the count line a warning colour when the magazine is nearly empty.</text>
	</string>
	<string id="ui_mcm_mag_check_hud_low_ammo_pct">
		<text>Low-ammo threshold (%)</text>
	</string>
	<string id="ui_mcm_mag_check_hud_low_ammo_pct_title">
		<text>Low-ammo threshold (%)</text>
	</string>
	<string id="ui_mcm_mag_check_hud_low_ammo_pct_desc">
		<text>The magazine counts as low at or below this percentage of its capacity.</text>
	</string>
	<string id="ui_mcm_mag_check_hud_color_low">
		<text>Color: low ammo</text>
