<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_mag_check_hud_title">
		<text>Mag Check HUD</text>
	</string>
	<string id="ui_mm_title_mag_check_hud">
		<text>Mag Check HUD</text>
	</string>
	<string id="ui_mcm_mag_check_hud_enabled">
		<text>Enable Mag Check HUD</text>
	</string>
	<string id="ui_mcm_mag_check_hud_enabled_desc">
		<text>Show the ammo count on screen during the Mags Redux ammo check.</text>
	</string>
	<string id="ui_mcm_mag_check_hud_hide_center_message">
		<text>Hide center-screen message</text>
	</string>
	<string id="ui_mcm_mag_check_hud_hide_center_message_desc">
		<text>Hide the game's own 'About Half, 5.56x45 AP' message while this HUD is showing.</text>
	</string>
	<string id="ui_mcm_mag_check_hud_show_chamber_line">
		<text>Show chamber line</text>
	</string>
	<string id="ui_mcm_mag_check_hud_show_chamber_line_desc">
		<text>Show a second line with the round currently in the chamber, in its own color.</text>
	</string>
	<string id="ui_mcm_mag_check_hud_chamber_always">
		<text>Always show chamber line</text>
	</string>
	<string id="ui_mcm_mag_check_hud_chamber_always_desc">
		<text>Off: only show the chamber line when it differs from the magazine's next round.</text>
	</string>
	<string id="ui_mcm_mag_check_hud_show_mixed_label">
		<text>Show 'Mixed Ammo' label</text>
	</string>
	<string id="ui_mcm_mag_check_hud_show_mixed_label_desc">
		<text>Show a 'Mixed Ammo' message above the count when the magazine holds more than one ammo type.</text>
	</string>
	<string id="ui_mcm_mag_check_hud_hide_after">
		<text>Hide timeout (seconds)</text>
	</string>
	<string id="ui_mcm_mag_check_hud_hide_after_desc">
		<text>Safety timeout: hide the text after this many seconds if the weapon-back check never triggers.</text>
	</string>
	<string id="ui_mcm_mag_check_hud_offset_x">
		<text>Horizontal offset</text>
	</string>
	<string id="ui_mcm_mag_check_hud_offset_x_desc">
		<text>Move the HUD left (negative) or right (positive).</text>
	</string>
	<string id="ui_mcm_mag_check_hud_offset_y">
		<text>Vertical offset</text>
	</string>
	<string id="ui_mcm_mag_check_hud_offset_y_desc">
		<text>Move the HUD up (negative) or down (positive).</text>
	</string>
	<string id="ui_mcm_mag_check_hud_use_colors">
		<text>Color-code round types</text>
	</string>
	<string id="ui_mcm_mag_check_hud_use_colors_desc">
		<text>Color the text by round type. Off: everything is white.</text>
	</string>
	<string id="ui_mcm_mag_check_hud_color_ap">
