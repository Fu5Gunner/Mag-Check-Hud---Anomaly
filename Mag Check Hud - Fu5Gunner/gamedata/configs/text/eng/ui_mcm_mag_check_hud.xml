	<string id="ui_mcm_mag_check_hud_show_next_round_title">
		<text>Show next rounds line</text>
	</string>
	<string id="ui_mcm_mag_check_hud_show_next_round_desc">
		<text>Show the firing order, e.g. 'Next: FMJ > AP' (chambered round first, then the magazine's next round). Off by default.</text>
	</string>
