	</string>
	<string id="ui_mcm_mag_check_hud_font_size_title">
		<text>Font size</text>
	</string>
	<string id="ui_mcm_mag_check_hud_font_size_desc">
		<text>Size of the HUD text. If a size has no effect, your game build may not expose that font; turn on Debug logging to check.</text>
	</string>
	<string id="ui_mcm_mag_check_hud_opacity">
